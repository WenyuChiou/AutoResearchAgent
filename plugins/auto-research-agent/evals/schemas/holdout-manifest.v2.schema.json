{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/auto-research-agent/holdout-manifest.v2.schema.json",
  "title": "HoldoutManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "manifest_id",
    "case_id",
    "rubric_version",
    "use_class",
    "status",
    "cutoff_date",
    "coverage_clusters",
    "required_roles",
    "curation",
    "anchors",
    "candidate_screening_log",
    "disagreements",
    "answer_key",
    "production_runtime_may_read",
    "created_at",
    "frozen_at"
  ],
  "properties": {
    "kind": {
      "const": "HoldoutManifest"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "const": "aging-sk-bidirectional-development-v2"
    },
    "rubric_version": {
      "const": "aging-bidirectional-rubric-v1"
    },
    "use_class": {
      "enum": [
        "synthetic",
        "scientific"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "coverage_clusters": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_roles": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "theoretical-mechanism",
          "quantitative-evidence",
          "population-to-agent",
          "simulation-method",
          "cross-context-case",
          "validation"
        ]
      }
    },
    "curation": {
      "$ref": "#/$defs/curation"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "answer_key": {
      "$ref": "#/$defs/artifact"
    },
    "production_runtime_may_read": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "disagreements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disagreement"
      }
    },
    "candidate_screening_log": {
      "$ref": "#/$defs/artifact"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "privatePath": {
      "type": "string",
      "pattern": "^private/.+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/privatePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "independent_rating",
        "human_approvals"
      ],
      "properties": {
        "actors": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/actor"
          },
          "maxItems": 2
        },
        "independent_rating": {
          "const": true
        },
        "human_approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "role",
        "attestation_ref"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "actor_type": {
          "const": "human"
        },
        "role": {
          "enum": [
            "rater"
          ]
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "approved_at",
        "approval_artifact"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "year",
        "venue_or_version",
        "doi_or_url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "venue_or_version": {
          "type": "string",
          "minLength": 1
        },
        "doi_or_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "field_recognition",
        "foundational_role",
        "durability",
        "authority_evidence_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "qualifies",
            "does-not-qualify",
            "not-applicable"
          ]
        },
        "field_recognition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "foundational_role": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "durability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "authority_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directness",
        "decision_impact",
        "evidence_quality",
        "equally_direct_substitute"
      ],
      "properties": {
        "directness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "decision_impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "evidence_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "equally_direct_substitute": {
          "type": "boolean"
        }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rater_id",
        "decision",
        "reason",
        "evidence_ids",
        "must_have_assessment"
      ],
      "properties": {
        "rater_id": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "must_have_assessment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/mustHaveAssessment"
            }
          ]
        }
      }
    },
    "mustHaveAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directness",
        "decision_impact",
        "evidence_quality",
        "no_equally_direct_substitute"
      ],
      "properties": {
        "directness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "decision_impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "evidence_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "no_equally_direct_substitute": {
          "type": "boolean"
        }
      }
    },
    "adjudication": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adjudicator_id",
            "decision",
            "reason",
            "evidence_ids",
            "decided_at"
          ],
          "properties": {
            "adjudicator_id": {
              "$ref": "#/$defs/id"
            },
            "decision": {
              "enum": [
                "include",
                "exclude"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "identity",
        "anchor_type",
        "coverage_clusters",
        "roles",
        "classic_assessment",
        "importance",
        "inclusion_reason",
        "evidence_locators",
        "independent_ratings"
      ],
      "properties": {
        "anchor_id": {
          "$ref": "#/$defs/id"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "anchor_type": {
          "enum": [
            "core",
            "must-have",
            "core-and-must-have"
          ]
        },
        "coverage_clusters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "theoretical-mechanism",
              "quantitative-evidence",
              "population-to-agent",
              "simulation-method",
              "cross-context-case",
              "validation"
            ]
          }
        },
        "classic_assessment": {
          "$ref": "#/$defs/classic"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "inclusion_reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_ratings": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/rating"
          },
          "maxItems": 2
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "identity",
        "independent_ratings",
        "exclusion_reason"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "independent_ratings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/rating"
          }
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
