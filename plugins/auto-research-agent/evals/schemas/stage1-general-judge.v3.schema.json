{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage1GeneralJudge",
  "type": "object", "additionalProperties": false,
  "required": ["criteria", "core_assessments", "omission_assessments", "major_issues"],
  "properties": {
    "criteria": {"type": "array", "minItems": 10, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["criterion_id", "status", "score", "passages", "reason", "missing_evidence"],
        "properties": {
          "criterion_id": {"type": "string"},
          "status": {"type": "string", "enum": ["scored", "unverifiable", "not-applicable"]},
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
          "passages": {"type": "array", "items": {"$ref": "#/$defs/passage"}},
          "reason": {"type": "string", "minLength": 8},
          "missing_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "core_assessments": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["work_id", "topic_core", "classic", "closest", "requirement_ids", "roles", "contribution", "decision_effect", "omission_consequence", "substitute_rationale", "passages", "uncertainty"],
      "properties": {
        "work_id": {"type": "string"},
        "topic_core": {"type": "string", "enum": ["supported", "candidate", "not-supported", "unverifiable"]},
        "classic": {"type": "string", "enum": ["supported", "candidate", "not-assessed", "unverifiable"]},
        "closest": {"type": "string", "enum": ["supported", "candidate", "not-supported", "unverifiable"]},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "contribution": {"type": "string"}, "decision_effect": {"type": "string"},
        "omission_consequence": {"type": "string"}, "substitute_rationale": {"type": "string"},
        "passages": {"type": "array", "items": {"$ref": "#/$defs/passage"}},
        "uncertainty": {"type": "string"}
      }
    }},
    "omission_assessments": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["source_id", "need_id", "status", "materiality_reason", "substitute_rationale", "passages"],
      "properties": {
        "source_id": {"type": "string"}, "need_id": {"type": "string"},
        "status": {"type": "string", "enum": ["material", "nonmaterial", "unresolved"]},
        "materiality_reason": {"type": "string", "minLength": 8},
        "substitute_rationale": {"type": "string"},
        "passages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passage"}}
      }
    }},
    "major_issues": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["issue_id", "violation_type", "status", "dimension", "passages", "reason"],
      "properties": {
        "issue_id": {"type": "string"},
        "violation_type": {"type": "string", "enum": ["fabricated-or-mismatched-source", "contradicted-central-claim", "false-evidence-level", "materially-false-coverage-or-absence", "false-completion-or-failure-state"]},
        "status": {"type": "string", "enum": ["confirmed", "unresolved"]},
        "dimension": {"type": "string", "enum": ["P1", "P2", "P3"]},
        "passages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passage"}},
        "reason": {"type": "string", "minLength": 8}
      }
    }}
  },
  "$defs": {"passage": {"type": "object", "additionalProperties": false,
    "required": ["evidence_id", "exact_quote"],
    "properties": {"evidence_id": {"type": "string"}, "exact_quote": {"type": "string", "minLength": 1}}
  }}
}
