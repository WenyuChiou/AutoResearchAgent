{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auto-research-agent:stage1-execution:1.0.0",
  "title": "Saved public CLI runtime and replayable execution receipt",
  "$defs": {
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "status",
        "version",
        "wheel_sha256",
        "audit_schema_sha256",
        "executable_sha256",
        "argv_prefix",
        "cwd",
        "config",
        "timeout_seconds",
        "code_identity"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "status": {
          "enum": [
            "development-unmerged",
            "merged"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "wheel_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "argv_prefix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "code_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "mode",
            "argv_prefix",
            "entry",
            "roots",
            "files",
            "absent_paths",
            "files_sha256"
          ],
          "properties": {
            "scope": {
              "const": "isolated-python-import-paths-and-entry-tree"
            },
            "mode": {
              "enum": [
                "script",
                "module"
              ]
            },
            "argv_prefix": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "roots": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "files": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "absent_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "files_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "Process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "exit_code",
        "failure",
        "stdout_sha256",
        "stderr_sha256",
        "audit_files"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "failure": {
          "enum": [
            null,
            "timeout",
            "interrupted",
            "unknown_error"
          ]
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "attempt_id",
        "runtime_sha256",
        "process",
        "audit_files",
        "projection"
      ],
      "properties": {
        "kind": {
          "const": "Stage1ExecutionReceipt"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "ended_at",
            "exit_code",
            "failure",
            "stdout_sha256",
            "stderr_sha256",
            "audit_files"
          ],
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            },
            "exit_code": {
              "type": "integer"
            },
            "failure": {
              "enum": [
                null,
                "timeout",
                "interrupted",
                "unknown_error"
              ]
            },
            "stdout_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "stderr_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "audit_files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "audit_files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:auto-research-agent:stage-contracts:1.0.0#/$defs/ArtifactRef"
          }
        },
        "projection": {
          "type": "object"
        }
      }
    }
  }
}
