{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2-packet.v2_4.schema.json",
  "title": "Stage 2 scientific packet v2.4 with candidate-bound prior-work reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "packet_id", "brief", "resources", "comparison", "literature", "supplemental_literature", "evidence", "sources", "candidates", "unresolved", "upstream", "research_tables", "prior_work_reviews"],
  "properties": {
    "kind": {"$ref": "stage2-packet.v2_3.schema.json#/properties/kind"},
    "schema_version": {"const": "2.4.0"},
    "packet_id": {"$ref": "stage2-packet.v2_3.schema.json#/properties/packet_id"},
    "brief": {"$ref": "stage2-packet.v2_3.schema.json#/properties/brief"},
    "resources": {"$ref": "stage2-packet.v2_3.schema.json#/properties/resources"},
    "comparison": {"$ref": "stage2-packet.v2_3.schema.json#/properties/comparison"},
    "literature": {"$ref": "stage2-packet.v2_3.schema.json#/properties/literature"},
    "supplemental_literature": {"$ref": "stage2-packet.v2_3.schema.json#/properties/supplemental_literature"},
    "sources": {"$ref": "stage2-packet.v2_3.schema.json#/properties/sources"},
    "evidence": {"$ref": "stage2-packet.v2_3.schema.json#/properties/evidence"},
    "candidates": {"$ref": "stage2-packet.v2_3.schema.json#/properties/candidates"},
    "unresolved": {"$ref": "stage2-packet.v2_3.schema.json#/properties/unresolved"},
    "upstream": {"$ref": "stage2-packet.v2_3.schema.json#/properties/upstream"},
    "research_tables": {"$ref": "stage2-packet.v2_3.schema.json#/properties/research_tables"},
    "prior_work_reviews": {"type": "array", "items": {"$ref": "#/$defs/prior_work_review"}}
  },
  "oneOf": [
    {"$ref": "stage2-packet.v2_3.schema.json#/oneOf/0"},
    {"$ref": "stage2-packet.v2_3.schema.json#/oneOf/1"}
  ],
  "$defs": {
    "work_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "version_id"],
      "properties": {
        "work_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "required": ["search_id", "need", "query", "status", "tool_ref", "raw_path", "raw_sha256", "outcome", "work_refs"],
      "properties": {
        "search_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "need": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "query": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "status": {"enum": ["executed", "unavailable", "planned"]},
        "tool_ref": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "raw_path": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "raw_sha256": {"anyOf": [{"$ref": "stage2-packet.v2.schema.json#/$defs/sha"}, {"type": "null"}]},
        "outcome": {"enum": ["results", "empty", "failure", "unknown"]},
        "work_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/work_ref"}}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "version_id", "role", "established", "overlap", "difference", "evidence_ids", "limitations"],
      "properties": {
        "work_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "role": {"enum": ["closest", "method-comparator", "contrary", "boundary"]},
        "established": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "overlap": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "difference": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "limitations": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}}
      }
    },
    "prior_work_review": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "candidate_id", "candidate_version", "candidate_sha256", "source_set_sha256", "positioning", "review_status", "stop_reason", "search_limits", "unresolved", "searches", "comparisons"],
      "properties": {
        "kind": {"const": "Stage2PriorWorkReview"},
        "schema_version": {"const": "1.0.0"},
        "candidate_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "candidate_version": {"type": "integer", "minimum": 1},
        "candidate_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "source_set_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "positioning": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "review_status": {"enum": ["partial", "bounded-complete"]},
        "stop_reason": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "search_limits": {"type": "array", "minItems": 1, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "unresolved": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "searches": {"type": "array", "items": {"$ref": "#/$defs/search"}},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}}
      }
    }
  }
}
