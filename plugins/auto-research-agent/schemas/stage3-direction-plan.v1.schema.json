{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "intent_sha256", "planning_status", "question_plans", "markdown", "execution_authorized"],
  "properties": {
    "kind": {"const": "Stage3DirectionPlanningResult"},
    "schema_version": {"const": "1.0.0"},
    "intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_status": {"enum": ["conditional-draft", "needs-information"]},
    "markdown": {"type": "string", "minLength": 1},
    "execution_authorized": {"const": false},
    "question_plans": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_ref", "materials", "method", "design", "validation", "analysis", "interpretation", "unknowns", "minimum_deliverable"],
        "properties": {
          "question_ref": {"type": "string", "minLength": 1},
          "materials": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "design": {"type": "string", "minLength": 1},
          "validation": {"type": "string", "minLength": 1},
          "analysis": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1},
          "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "minimum_deliverable": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
