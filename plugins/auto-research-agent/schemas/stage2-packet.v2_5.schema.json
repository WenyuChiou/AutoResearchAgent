{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2-packet.v2_5.schema.json",
  "title": "Stage 2 scientific packet v2.5 with candidate scientific arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "packet_id", "brief", "resources", "comparison", "literature", "supplemental_literature", "evidence", "sources", "candidates", "unresolved", "upstream", "research_tables", "prior_work_reviews"],
  "properties": {
    "kind": {"$ref": "stage2-packet.v2_4.schema.json#/properties/kind"},
    "schema_version": {"const": "2.5.0"},
    "packet_id": {"$ref": "stage2-packet.v2_4.schema.json#/properties/packet_id"},
    "brief": {"$ref": "stage2-packet.v2_4.schema.json#/properties/brief"},
    "resources": {"$ref": "stage2-packet.v2_4.schema.json#/properties/resources"},
    "comparison": {"$ref": "stage2-packet.v2_4.schema.json#/properties/comparison"},
    "literature": {"$ref": "stage2-packet.v2_4.schema.json#/properties/literature"},
    "supplemental_literature": {"$ref": "stage2-packet.v2_4.schema.json#/properties/supplemental_literature"},
    "sources": {"$ref": "stage2-packet.v2_4.schema.json#/properties/sources"},
    "evidence": {"$ref": "stage2-packet.v2_4.schema.json#/properties/evidence"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "unresolved": {"$ref": "stage2-packet.v2_4.schema.json#/properties/unresolved"},
    "upstream": {"$ref": "stage2-packet.v2_4.schema.json#/properties/upstream"},
    "research_tables": {"$ref": "stage2-packet.v2_4.schema.json#/properties/research_tables"},
    "prior_work_reviews": {"$ref": "stage2-packet.v2_4.schema.json#/properties/prior_work_reviews"}
  },
  "oneOf": [
    {"$ref": "stage2-packet.v2_4.schema.json#/oneOf/0"},
    {"$ref": "stage2-packet.v2_4.schema.json#/oneOf/1"}
  ],
  "$defs": {
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "work_id", "version_id"],
      "properties": {
        "source_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "work_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}
      }
    },
    "proposal_span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "status", "evidence_ids", "source_refs", "proposal_spans"],
      "properties": {
        "text": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "status": {"enum": ["fact", "inference", "proposal", "unknown"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_ref"}},
        "proposal_spans": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/proposal_span"}}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "statement", "importance"],
      "properties": {
        "gap_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "statement": {"$ref": "#/$defs/claim"},
        "importance": {"$ref": "#/$defs/claim"}
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "kind", "statement", "gap_ids", "question_ids"],
      "properties": {
        "challenge_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "kind": {"enum": ["scientific", "implementation"]},
        "statement": {"$ref": "#/$defs/claim"},
        "gap_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "text", "priority", "gap_ids", "object", "intended_claim", "status"],
      "properties": {
        "question_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "text": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "priority": {"enum": ["core", "secondary"]},
        "gap_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "object": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "intended_claim": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "status": {"enum": ["proposal", "unknown"]}
      }
    },
    "contribution_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "question_ids", "status"],
      "properties": {
        "text": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "status": {"enum": ["proposal", "unknown"]}
      }
    },
    "resource_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "question_ids", "purpose", "fit_status", "evidence_ids"],
      "properties": {
        "resource_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "purpose": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "fit_status": {"enum": ["proposed", "supported", "unknown"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}}
      }
    },
    "scientific_argument": {
      "type": "object", "additionalProperties": false,
      "required": ["motivation", "current_state", "gaps", "challenges", "questions", "contribution_claims", "resource_refs"],
      "properties": {
        "motivation": {"$ref": "#/$defs/claim"},
        "current_state": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "gaps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gap"}},
        "challenges": {"type": "array", "items": {"$ref": "#/$defs/challenge"}},
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
        "contribution_claims": {"type": "array", "items": {"$ref": "#/$defs/contribution_claim"}},
        "resource_refs": {"type": "array", "items": {"$ref": "#/$defs/resource_ref"}}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "version", "parent_version", "question", "research_mode", "opportunity", "value", "approach", "requirements", "limitations", "evidence_ids", "scientific_argument"],
      "properties": {
        "candidate_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "parent_version": {"type": ["integer", "null"], "minimum": 1},
        "question": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "research_mode": {"enum": ["exploratory", "confirmatory", "method-development", "theory", "replication", "validation"]},
        "opportunity": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "value": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "approach": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "requirements": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "limitations": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "evidence_ids": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "scientific_argument": {"$ref": "#/$defs/scientific_argument"}
      }
    }
  }
}
