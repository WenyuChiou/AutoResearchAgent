{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2-packet.v2_2.schema.json",
  "title": "Stage 2 scientific packet v2.2 with source-bound research tables",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "packet_id", "brief", "resources", "comparison", "literature", "evidence", "sources", "candidates", "unresolved", "upstream", "research_tables"],
  "properties": {
    "kind": {"const": "Stage2Packet"},
    "schema_version": {"const": "2.2.0"},
    "packet_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
    "brief": {"type": "object"},
    "resources": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
    "comparison": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
    "literature": {"type": "array", "minItems": 1, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/literature"}},
    "sources": {"type": "array", "minItems": 1},
    "evidence": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/evidence"}},
    "candidates": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/candidate"}},
    "unresolved": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
    "upstream": {"type": "object"},
    "research_tables": {"anyOf": [{"$ref": "#/$defs/research_tables"}, {"type": "null"}]}
  },
  "oneOf": [
    {
      "properties": {
        "sources": {"items": {"$ref": "stage2-packet.v2.schema.json#/$defs/source"}},
        "upstream": {"$ref": "stage2-packet.v2.schema.json#/$defs/upstream"}
      }
    },
    {
      "properties": {
        "sources": {"items": {"$ref": "stage2-packet.v2_1.schema.json#/$defs/source"}},
        "upstream": {"$ref": "stage2-packet.v2_1.schema.json#/$defs/upstream"}
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "quote"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "label", "research_need", "rationale", "definition", "value_kind", "conditions", "spans"],
      "properties": {
        "dimension_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "label": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "research_need": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "rationale": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "definition": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "value_kind": {"enum": ["feature", "text", "quantity"]},
        "conditions": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "work_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "version_id"],
      "properties": {
        "work_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "work_id", "version_id", "status", "value", "reason", "inspection_scope", "negative_basis", "evidence_ids", "spans"],
      "properties": {
        "dimension_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "work_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "version_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "status": {"enum": ["present", "absent", "partial", "described", "unknown", "not-applicable"]},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "reason": {"type": ["string", "null"]},
        "inspection_scope": {"type": ["string", "null"]},
        "negative_basis": {"enum": ["explicit-statement", "bounded-design-inspection", null]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "direction_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "candidate_id", "candidate_version", "category", "name", "purpose", "url", "version", "required", "status", "access_conditions", "license", "cost_basis", "limitations", "alternatives", "evidence_ids", "checked_at", "spans"],
      "properties": {
        "resource_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "candidate_id": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"},
        "candidate_version": {"type": "integer", "minimum": 1},
        "category": {"enum": ["dataset", "report", "reference", "model", "tool"]},
        "name": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "purpose": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "url": {"type": ["string", "null"], "format": "uri"},
        "version": {"type": ["string", "null"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["available", "restricted", "unavailable", "unknown", "not-applicable"]},
        "access_conditions": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "cost_basis": {"type": ["string", "null"]},
        "limitations": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "alternatives": {"type": "array", "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "stage2-packet.v2.schema.json#/$defs/id"}},
        "checked_at": {"type": ["string", "null"]},
        "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "research_tables": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "brief_sha256", "input_packet_sha256", "input_snapshot_sha256", "raw_proposal", "raw_proposal_sha256", "dimensions", "work_refs", "cells", "direction_resources"],
      "properties": {
        "kind": {"const": "Stage2ResearchTables"},
        "schema_version": {"const": "1.0.0"},
        "brief_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "input_packet_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "input_snapshot_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "raw_proposal": {"$ref": "stage2-packet.v2.schema.json#/$defs/text"},
        "raw_proposal_sha256": {"$ref": "stage2-packet.v2.schema.json#/$defs/sha"},
        "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
        "work_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work_ref"}},
        "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "direction_resources": {"type": "array", "items": {"$ref": "#/$defs/direction_resource"}}
      }
    }
  }
}
