{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2-packet.v2_7.schema.json",
  "title": "Stage 2 scientific packet with original current-Core provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "packet_id",
    "brief",
    "resources",
    "comparison",
    "literature",
    "supplemental_literature",
    "evidence",
    "sources",
    "candidates",
    "unresolved",
    "upstream",
    "research_tables",
    "prior_work_reviews",
    "core_source"
  ],
  "properties": {
    "kind": {"$ref":"stage2-packet.v2_5.schema.json#/properties/kind"},
    "schema_version": {"const":"2.7.0"},
    "packet_id": {"$ref":"stage2-packet.v2_5.schema.json#/properties/packet_id"},
    "brief": {"$ref":"stage2-packet.v2_5.schema.json#/properties/brief"},
    "resources": {"$ref":"stage2-packet.v2_5.schema.json#/properties/resources"},
    "comparison": {"$ref":"stage2-packet.v2_5.schema.json#/properties/comparison"},
    "literature": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/literature"}},
    "supplemental_literature": {"$ref":"stage2-packet.v2_5.schema.json#/properties/supplemental_literature"},
    "evidence": {
      "type": "array",
      "items": {"oneOf":[{"$ref":"#/$defs/core_evidence"},{"allOf":[{"$ref":"stage2-packet.v2.schema.json#/$defs/evidence"},{"properties":{"origin":{"const":"stage2"}}}]}]}
    },
    "sources": {"$ref":"stage2-packet.v2_5.schema.json#/properties/sources"},
    "candidates": {"$ref":"stage2-packet.v2_5.schema.json#/properties/candidates"},
    "unresolved": {"$ref":"stage2-packet.v2_5.schema.json#/properties/unresolved"},
    "upstream": {"$ref":"stage2-packet.v2.schema.json#/$defs/upstream"},
    "research_tables": {"$ref":"stage2-packet.v2_5.schema.json#/properties/research_tables"},
    "prior_work_reviews": {"$ref":"stage2-packet.v2_5.schema.json#/properties/prior_work_reviews"},
    "core_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","schema_version","records_version","files","scientific_quality_verified","execution_authorized"],
      "properties": {
        "kind": {"const":"Stage1CoreSource"},
        "schema_version": {"const":"1.0.0"},
        "records_version": {"enum":["1.1.0","1.2.0"]},
        "files": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path","sha256"],
            "properties": {"path":{"type":"string","pattern":"^stage1_core/[^\\\\]+$"},"sha256":{"$ref":"stage2-packet.v2.schema.json#/$defs/sha"}}
          }
        },
        "scientific_quality_verified": {"const":false},
        "execution_authorized": {"const":false}
      }
    }
  },
  "$defs": {
    "literature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin","work_id","version_id","title","authors","year","venue","doi","url","evidence_level","source_ids","classification","roles","findings","claim_ids"],
      "properties": {
        "origin": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/origin"},
        "work_id": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/work_id"},
        "version_id": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/version_id"},
        "title": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/title"},
        "authors": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/authors"},
        "year": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/year"},
        "venue": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/venue"},
        "doi": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/doi"},
        "url": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/url"},
        "evidence_level": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/evidence_level"},
        "source_ids": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/source_ids"},
        "classification": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/classification"},
        "roles": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/roles"},
        "findings": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/findings"},
        "claim_ids": {"$ref":"stage2-packet.v2.schema.json#/$defs/literature/properties/claim_ids"},
        "reading_status": {"type":"string","minLength":1}
      }
    },
    "core_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin","evidence_id","source_id","work_id","version_id","claim_text","relation","evidence_level","locator","quote","start","end","core_event_sha256","core_artifact"],
      "properties": {
        "origin": {"const":"stage1"},
        "evidence_id": {"$ref":"stage2-packet.v2.schema.json#/$defs/evidence/properties/evidence_id"},
        "source_id": {"anyOf":[{"$ref":"stage2-packet.v2.schema.json#/$defs/id"},{"type":"null"}]},
        "work_id": {"$ref":"stage2-packet.v2.schema.json#/$defs/evidence/properties/work_id"},
        "version_id": {"$ref":"stage2-packet.v2.schema.json#/$defs/evidence/properties/version_id"},
        "claim_text": {"$ref":"stage2-packet.v2.schema.json#/$defs/evidence/properties/claim_text"},
        "relation": {"enum":["pending","supports","partial","contradicts","unclear","unverifiable","context"]},
        "evidence_level": {"enum":["metadata","abstract","full-text","full_text","primary_data_or_table","unavailable"]},
        "locator": {"type":["string","null"],"minLength":1},
        "quote": {"type":["string","null"],"minLength":1},
        "start": {"type":["integer","null"],"minimum":0},
        "end": {"type":["integer","null"],"minimum":1},
        "core_event_sha256": {"$ref":"stage2-packet.v2.schema.json#/$defs/sha"},
        "core_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path","sha256"],
          "properties": {"path":{"type":"string","pattern":"^stage1_core/core_claim_artifacts/[a-f0-9]{64}\\.bin$"},"sha256":{"$ref":"stage2-packet.v2.schema.json#/$defs/sha"}}
        }
      }
    }
  }
}
